# academix-frontend — variables de entorno públicas
# Copia este archivo como .env (o .env.local) y completa los valores reales.
# Nunca subas el .env real a git.

# URL base de academix-backend. No incluyas slash al final.
# Ejemplo local: http://localhost:3000/api/v1
VITE_API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:5173,http://localhost:4173

# Integración real con academix-backend. Usa "mock" solo para demostraciones aisladas.
VITE_DATA_SOURCE=api

# Token público de Mapbox (usado en la sección de ubicación de /contacto)
VITE_MAPBOX_TOKEN=

# Caché de metadatos en memoria; milisegundos, sin tokens ni permisos.
VITE_CATALOG_TTL_MS=60000
VITE_FEATURED_TTL_MS=30000
VITE_LIBRARY_TTL_MS=30000
VITE_QUERY_GC_MS=300000
VITE_QUERY_MAX_INACTIVE=80
